{
    "name": "ahmedmerza/logscope",
    "description": "A fast, database-backed log viewer for Laravel applications",
    "keywords": [
        "laravel",
        "logs",
        "logging",
        "log-viewer",
        "debugging",
        "monitoring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "AhmedMerza",
            "email": "ahmedmerzaali@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "laravel/sanctum": "^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^5.0"
    },
    "suggest": {
        "laravel/sanctum": "Token authentication for the opt-in v1 JSON API (routes.api)."
    },
    "autoload": {
        "psr-4": {
            "LogScope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LogScope\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LogScope\\LogScopeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "format": "pint"
    }
}
